# Copy to .env.local and set values from your Supabase project dashboard.
# Use only the publishable/anon key in this Next.js application.
# Never put a service_role key in any NEXT_PUBLIC variable or in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false until SACku approves its final privacy notice and registration flow.
SACKU_REGISTRATION_ENABLED=false
